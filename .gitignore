# =============================================================================
# .gitignore — Terraform & general project ignores
# =============================================================================

# ----- Terraform state & local files -----
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
terraform.tfvars          # Contains real values — never commit
*.auto.tfvars             # Auto-loaded var files with real values
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Terraform plan files (may contain sensitive data)
*.tfplan
*.tfplan.binary

# ----- Secrets & credentials -----
*.pem
*.key
*.p12
*.pfx
.env
.env.*
secrets.yml
secrets.yaml

# ----- AWS -----
.aws/credentials

# ----- macOS -----
.DS_Store
.AppleDouble
.LSOverride
._*

# ----- VS Code -----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ----- JetBrains IDEs -----
.idea/
*.iml

# ----- Python (scripts/tooling) -----
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# ----- Node (scripts/tooling) -----
node_modules/
npm-debug.log*

# ----- Misc -----
*.log
*.bak
*.tmp
*.swp
*.swo
